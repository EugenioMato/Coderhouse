# Copiar este archivo como .env y completar la clave.
# El .env real está en .gitignore: nunca se sube al repositorio.

# Clave de Gemini. Se saca gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aca

# Modelo a usar (opcional). Por defecto: gemini-flash-lite-latest.
# Los modelos "lite" tienen una cuota diaria más alta en el tier gratuito;
# los flash grandes permiten solo 20 pedidos por día.
GEMINI_MODEL=gemini-flash-lite-latest
