# Copiar este archivo como .env y completar la clave.
# El .env real está en .gitignore: nunca se sube al repositorio.

# Proveedor a usar: gemini (el único implementado en esta entrega).
LLM_PROVIDER=gemini

# Clave de Gemini. Se saca gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aca

# Estos proveedores no están implementados todavía (ver README).
OPENAI_API_KEY=tu_clave_de_openai_aca
ANTHROPIC_API_KEY=tu_clave_de_anthropic_aca
